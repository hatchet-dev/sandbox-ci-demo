HATCHET_CLIENT_TOKEN=
SANDBOX_PROVIDER=archil
SANDBOX_TEMPLATE=docker:28.3.3-dind
SANDBOX_WORKDIR=/workspace
SANDBOX_VCPU=4
SANDBOX_MEMORY=8Gi
REPO_URL=https://github.com/<owner>/sandboxes-tui-demo.git
DEFAULT_BRANCH=main
SERVICES=api,worker
DOCKERFILE=sample/Dockerfile
REGISTRY_UPSTREAM=https://ghcr.io
IMAGE_PREFIX=ghcr.io/<owner>/sandboxes-tui-demo
REGISTRY_USER=<github user>
REGISTRY_PASSWORD=<github PAT with write:packages>
GITHUB_TOKEN=
PROXY_PUBLIC_URL=
